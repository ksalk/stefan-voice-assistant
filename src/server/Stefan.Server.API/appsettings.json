{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TimerDb": "Data Source=timers.db",
    "StefanDb": "Host=localhost;Port=5432;Database=stefan_db;Username=stefan;Password=changeme"
  },
  "Cors": {
    "Dashboard": {
      "AllowedOrigins": "",
      "AllowAnyHeader": true,
      "AllowAnyMethod": true
    }
  },
  "NodeSecret": "",
  "OpenAI": {
    "ApiKey": "sk-**************************",
    "Model": "openai/gpt-oss-safeguard-20b:nitro",
    "Endpoint": "https://openrouter.ai/api/v1"
  },
  "Piper": {
    "ExecutablePath": "piper/piper",
    "WorkingDirectory": "piper",
    "ModelKey": "en_US-hfc_female-medium"
  },
  "SttProvider": "XAi",
